<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ScreenTextMonitor</RootNamespace>
    <AssemblyName>ScreenTextMonitor</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CA1416;SYSLIB0014</NoWarn>
  </PropertyGroup>

  <!-- landing/ 是独立的 Vite + WebView2 包装子项目，不并入主工程编译，否则会
       误编其 .cs 并引发 WebView2 引用缺失 / AssemblyInfo 重复等错误。 -->
  <ItemGroup>
    <Compile Remove="landing\**\*.cs" />
    <EmbeddedResource Remove="landing\**\*" />
    <None Remove="landing\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.27.0" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <PackageReference Include="RapidOcrNet" Version="3.0.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="models_ppocrv6\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- F15：RapidOcrNet.targets 默认会把未使用的 v5 模型拷进输出导致膨胀；
       在其拷贝前清空 @(Models) 即可阻止，不影响自有 v4 det/cls + v6 rec 加载。 -->
  <Target Name="_SuppressRapidOcrV5Models" BeforeTargets="CopyModelsBuild;CopyModelsPublish">
    <ItemGroup>
      <Models Remove="@(Models)" />
    </ItemGroup>
  </Target>

</Project>
